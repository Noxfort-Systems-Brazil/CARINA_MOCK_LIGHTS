# Auto detect text files and perform LF normalization on checkout/commit
* text=auto

# Ensure shell scripts always preserve LF line endings
*.sh text eol=lf
*.bash text eol=lf

# Python files
*.py text diff=python eol=lf

# Web & TypeScript files
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Config & Docs
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.gz binary
*.pdf binary
